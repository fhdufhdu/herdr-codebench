  "colors": {
    "canvas": "#14171D",
    "background": "#181C23",
    "surface": "#20252E",
    "chrome": "#181C23",
    "popover": "#272E39",
    "border": "#394352",
    "foreground": "#EEF2F7",
    "muted": "#B4BFCE",
    "dim": "#7D899C",
    "accent": "#88B9FF",
    "selected": "#29466B",
    "hover": "#303A49"
  }
}
