{
  "go": {
    "extensions": [
      "go"
    ],
    "markers": [
      "go.work",
      "go.mod"
    ],
    "root": "nearest",
    "commands": [
      [
        "gopls"
      ]
    ]
  },
  "rust": {
    "extensions": [
      "rs"
    ],
    "markers": [
      "Cargo.toml"
    ],
    "root": "topmost",
    "commands": [
      [
        "rust-analyzer"
      ]
    ]
  },
  "swift": {
    "extensions": [
      "swift"
    ],
    "markers": [
      "Package.swift",
      "*.xcodeproj",
      "*.xcworkspace"
    ],
    "root": "nearest",
    "commands": [
      [
        "sourcekit-lsp"
      ],
      [
        "xcrun",
        "sourcekit-lsp"
      ]
    ]
  },
  "typescript": {
    "extensions": [
      "ts",
      "tsx",
      "mts",
      "cts",
      "js",
      "jsx",
      "mjs",
      "cjs"
    ],
    "markers": [
      "tsconfig.json",
      "jsconfig.json",
      "package.json"
    ],
    "root": "nearest",
    "commands": [
      [
        "typescript-language-server",
        "--stdio"
      ],
      [
        "vtsls",
        "--stdio"
      ]
    ],
    "init": {
      "tsserver": {
        "fallbackPath": "{npm_root}/typescript/lib"
      }
    }
  },
  "python": {
    "extensions": [
      "py",
      "pyi"
    ],
    "markers": [
      "pyproject.toml",
      "pyrightconfig.json",
      "setup.py",
      "setup.cfg",
      "requirements.txt"
    ],
    "root": "nearest",
    "commands": [
      [
        "basedpyright-langserver",
        "--stdio"
      ],
      [
        "pyright-langserver",
        "--stdio"
      ],
      [
        "pylsp"
      ]
    ]
  },
  "java": {
    "extensions": [
      "java"
    ],
    "markers": [
      "settings.gradle",
      "settings.gradle.kts",
      "pom.xml",
      "build.gradle",
      "build.gradle.kts"
    ],
    "root": "topmost",
    "commands": [
      [
        "jdtls",
        "--jvm-arg=-Xms64m",
        "--jvm-arg=-Xmx1g",
        "--jvm-arg=-XX:+UseG1GC",
        "--jvm-arg=-XX:G1PeriodicGCInterval=30000",
        "-data",
        "{cache}/jdtls/{root_hash}"
      ]
    ],
    "init": {
      "extendedClientCapabilities": {
        "classFileContentsSupport": true
      }
    }
  },
  "kotlin": {
    "extensions": [
      "kt",
      "kts"
    ],
    "markers": [
      "settings.gradle",
      "settings.gradle.kts",
      "pom.xml",
      "build.gradle",
      "build.gradle.kts"
    ],
    "root": "topmost",
    "commands": [
      [
        "kotlin-lsp",
        "--stdio"
      ],
      [
        "kotlin-language-server"
      ]
    ],
    "env": {
      "IJ_JAVA_OPTIONS": "-Xms64m -Xmx1g -XX:+UseG1GC -XX:G1PeriodicGCInterval=30000"
    }
  },
  "json": {
    "extensions": [
      "json",
      "jsonc"
    ],
    "markers": [
      "package.json"
    ],
    "root": "nearest",
    "commands": [
      [
        "vscode-json-language-server",
        "--stdio"
      ]
    ],
    "init": {
      "provideFormatter": true
    }
  },
  "yaml": {
    "extensions": [
      "yaml",
      "yml"
    ],
    "markers": [],
    "root": "nearest",
    "commands": [
      [
        "yaml-language-server",
        "--stdio"
      ]
    ]
  },
  "html": {
    "extensions": [
      "html",
      "htm"
    ],
    "markers": [
      "package.json"
    ],
    "root": "nearest",
    "commands": [
      [
        "vscode-html-language-server",
        "--stdio"
      ]
    ],
    "init": {
      "provideFormatter": true
    }
  },
  "css": {
    "extensions": [
      "css",
      "scss",
      "less"
    ],
    "markers": [
      "package.json"
    ],
    "root": "nearest",
    "commands": [
      [
        "vscode-css-language-server",
        "--stdio"
      ]
    ],
    "init": {
      "provideFormatter": true,
      "css": {
        "validate": true
      },
      "scss": {
        "validate": true
      },
      "less": {
        "validate": true
      }
    }
  },
  "shellscript": {
    "extensions": [
      "sh",
      "bash"
    ],
    "markers": [],
    "root": "nearest",
    "commands": [
      [
        "bash-language-server",
        "start"
      ]
    ]
  },
  "cpp": {
    "extensions": [
      "c",
      "h",
      "cc",
      "cpp",
      "cxx",
      "c++",
      "hh",
      "hpp",
      "hxx",
      "h++"
    ],
    "markers": [
      "compile_commands.json",
      "compile_flags.txt",
      ".clangd",
      "CMakeLists.txt"
    ],
    "root": "nearest",
    "commands": [
      [
        "clangd"
      ]
    ]
  },
  "markdown": {
    "extensions": [
      "md",
      "markdown"
    ],
    "markers": [
      ".marksman.toml"
    ],
    "root": "nearest",
    "commands": [
      [
        "marksman",
        "server"
      ]
    ]
  },
  "toml": {
    "extensions": [
      "toml"
    ],
    "markers": [
      "taplo.toml",
      ".taplo.toml"
    ],
    "root": "nearest",
    "commands": [
      [
        "taplo",
        "lsp",
        "stdio"
      ]
    ]
  },
  "xml": {
    "extensions": [
      "xml",
      "xsd",
      "xsl",
      "xslt",
      "svg"
    ],
    "markers": [],
    "root": "nearest",
    "commands": [
      [
        "lemminx"
      ]
    ]
  }
}
